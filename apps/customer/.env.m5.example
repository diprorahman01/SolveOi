# ADD these to your EXISTING apps/customer/.env.local; never overwrite existing M3 secrets.
# Required to call the M5 worker endpoint (at least 32 random characters):
M5_WORKER_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
M5_APP_URL=http://localhost:3001

# AI execution is OFF by default; leave these off until you deliberately configure provider access.
M5_AI_ENABLED=false
M5_SANDBOX_ENABLED=false
M5_AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
